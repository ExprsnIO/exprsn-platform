# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Environment / secrets (NEVER commit) ────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ─── TLS / PKI (generated by `npm run gen:certs` / `npm run pki:gen`) ─────────
certs/
# …but the SPA CA-admin feature dir is SOURCE code, not TLS material — the
# unanchored `certs/` above was silently ignoring it (broke the web build).
!web/src/features/certs/
!web/src/features/certs/**
# Certificates / private keys must never be committed (anywhere in the tree)
*.pem
*.key
*.crt
*.p12
*.pfx
*.csr

# ─── Frontend build artifact (nginx mounts web/dist) ─────────────────────────
web/dist/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
**/logs/
*.log

# ─── Runtime data (filevault blobs, CA working dir, etc.) ────────────────────
data/

# ─── Database backups (pg_dump archives + restore logs) ──────────────────────
backups/

# ─── Test / coverage output ──────────────────────────────────────────────────
coverage/
**/coverage/

# ─── OS / editor cruft ───────────────────────────────────────────────────────
.DS_Store
*.local
*.swp
.idea/
.vscode/

# Claude Code local settings & agent worktrees
.claude/
