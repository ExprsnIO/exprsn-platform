# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Environment / secrets (NEVER commit) ────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ─── TLS / PKI (generated by `npm run gen:certs` / `npm run pki:gen`) ─────────
certs/
# …but the SPA CA-admin feature dir is SOURCE code, not TLS material — the
# unanchored `certs/` above was silently ignoring it (broke the web build).
!web/src/features/certs/
!web/src/features/certs/**
# Certificates / private keys must never be committed (anywhere in the tree)
*.pem
*.key
*.crt
*.p12
*.pfx
*.csr

# ─── Frontend build artifact (nginx mounts web/dist) ─────────────────────────
web/dist/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
**/logs/
*.log

# ─── Runtime data (filevault blobs, CA working dir, etc.) ────────────────────
data/

# ─── Database backups (pg_dump archives + restore logs) ──────────────────────
backups/

# ─── Test / coverage output ──────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/
playwright-report/
test-results/

# ─── Tool caches ─────────────────────────────────────────────────────────────
.eslintcache
*.tsbuildinfo
.vite/

# ─── OS / editor cruft ───────────────────────────────────────────────────────
.DS_Store
*.local
# …but the BIND zone file is tracked config, not a local override —
# docker/bind/etc/named.conf loads it, and `*.local` was silently ignoring it
# (fresh clones got a named.conf pointing at a file that was never committed).
!docker/bind/etc/db.exprsn.local
*.swp
*.bak
*.orig
*.rej
.idea/
.vscode/

# Claude Code local settings & agent worktrees
.claude/

# ─── Foreign content from the origin remote's prior history ──────────────────
# The origin remote previously held an unrelated project (a C++17 embedded SQL
# engine + a Payments service). The unrelated-histories merge (89ff0ef) brought
# that content into the tree.
# - TransactionDB/ was removed in d3eb275; this entry stops it reappearing.
# - jsonlexicon-nodejs-main/ is STILL TRACKED pending the merge cleanup, so this
#   entry only keeps new files out of it — it does not untrack what is there.
TransactionDB/
jsonlexicon-nodejs-main/
