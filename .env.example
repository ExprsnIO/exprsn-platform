# ============================================================================
# Exprsn Platform — unified configuration
# Copy to .env and fill in secrets. One process, one HTTPS port, one database.
# ============================================================================

NODE_ENV=development

# ---- Development auth bypass (FAIL-CLOSED; never enable in production) -----
# Bypass only works when ALL are true: NODE_ENV=development, DEV_BYPASS=true,
# DEV_BYPASS_SECRET set (>= 32 chars) and sent as the x-dev-bypass-secret
# header, AND the request comes from loopback (127.0.0.1/::1).
# DEV_BYPASS=true
# DEV_BYPASS_SECRET=   # generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- HTTPS edge (the ONLY exposed port) ------------------------------------
HOST=0.0.0.0
HTTPS_PORT=8443
HTTP_REDIRECT_PORT=8080      # plain HTTP -> 301 to HTTPS. 0 disables.
PUBLIC_HOST=localhost:8443
# Comma-separated allowlist of browser origins permitted by CORS.
# Unset (or '*') means same-origin only — wildcards are never honored with
# credentials. Example:
# CORS_ORIGIN=https://app.exprsn.io,https://admin.exprsn.io
TRUST_PROXY=false

# ---- TLS -------------------------------------------------------------------
TLS_ENABLED=true
TLS_CERT_PATH=./certs/platform.crt
TLS_KEY_PATH=./certs/platform.key
# TLS_CA_PATH=

# ---- Single Postgres database (per-module schemas) -------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exprsn
DB_USER=exprsn
DB_PASSWORD=change_me
DB_SSL=false
# When DB_SSL=true the server certificate is VERIFIED by default.
# Set to false only as an explicit (unsafe) opt-out:
# DB_SSL_REJECT_UNAUTHORIZED=true
# Path to a custom CA bundle to trust for the Postgres connection:
# DB_SSL_CA=./certs/db-ca.pem
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_LOGGING=false

# ---- Shared Redis ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Service-to-service auth (@exprsn/shared serviceToken/serviceClient) ---
# Per-service tokens are derived as HMAC-SHA256(serviceId, SERVICE_TOKEN_SECRET),
# binding each service identity to its credential. REQUIRED, >= 32 chars,
# must not be a placeholder. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SERVICE_TOKEN_SECRET=
#
# Legacy shared static token — accepted ONLY while SERVICE_TOKEN_LEGACY_ALLOW=true
# during migration. Remove both once all services use SERVICE_TOKEN_SECRET.
# SERVICE_TOKEN_LEGACY_ALLOW=false
# SERVICE_TOKEN=
#
# Identity this process presents on outbound CA calls (X-Service-ID header).
# The unified platform runs as one process, so one identity covers all modules.
SERVICE_ID=platform

# ---- Observability (SP-5 / R3) ---------------------------------------------
# Prometheus metrics at GET /metrics (process + HTTP + socket gauges).
METRICS_ENABLED=true
# When set, /metrics requires `Authorization: Bearer <token>`. Leave unset and
# network-restrict the endpoint to the scrape target instead.
# METRICS_TOKEN=
# Error tracking activates ONLY when SENTRY_DSN is set AND @sentry/node is
# installed (`npm install @sentry/node`). Tracked errors carry the gateway
# correlation id. Left empty = disabled (no-op).
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# ---- Internal module base URLs (now all the single origin + prefix) --------
# Modules are in-process; these remain only for code paths that still issue
# HTTP calls through the gateway.
CA_SERVICE_URL=https://localhost:8443/ca
# CA_URL / CA_BASE_URL are the names read by the shared token + socket
# validators and the spark/timeline module configs (default localhost:3000).
CA_URL=https://localhost:8443/ca
CA_BASE_URL=https://localhost:8443/ca
AUTH_SERVICE_URL=https://localhost:8443/auth
SPARK_SERVICE_URL=https://localhost:8443/spark
NEXUS_SERVICE_URL=https://localhost:8443/nexus
FILEVAULT_SERVICE_URL=https://localhost:8443/filevault
VAULT_SERVICE_URL=https://localhost:8443/vault
TIMELINE_SERVICE_URL=https://localhost:8443/timeline
PREFETCH_SERVICE_URL=https://localhost:8443/prefetch
MODERATOR_SERVICE_URL=https://localhost:8443/moderator
LIVE_SERVICE_URL=https://localhost:8443/live
# Timeline notifications: there is no standalone Herald service in the platform;
# timeline posts notifications to the moderator module, which bridges them onto
# its /notifications socket namespace. Set HERALD_ENABLED=false to disable.
HERALD_SERVICE_URL=https://localhost:8443/moderator
# Fallback HMAC secret for the post-approval decision callback
# (POST /timeline/api/webhooks/approval). The persisted admin setting
# "Approval Secret" (Jobs & Queues → Timeline config → Moderation) takes
# precedence; this env var is only used when that setting is empty.
TIMELINE_APPROVAL_WEBHOOK_SECRET=
# HMAC secret gating the moderator-decision webhook
# (POST /timeline/api/webhooks/moderator). The moderator signs the raw JSON
# body with sha256 HMAC and sends it in x-webhook-signature. Fails closed:
# the endpoint returns 503 when this is unset and 401 without a valid signature.
MODERATOR_WEBHOOK_SECRET=

# ---- Auth / identity -------------------------------------------------------
JWT_SECRET=change_me
SESSION_SECRET=change_me
OIDC_ISSUER=https://localhost:8443/auth
# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Email (auth / moderator) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=

# ---- Moderator AI providers -----------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- AT-Protocol / Bluesky bridge (atproto module + worker:atproto) --------
# Master switch for the bridge behaviors (ops endpoints load regardless).
ATPROTO_ENABLED=false
# Firehose transport: jetstream (JSON, default) | subscribeRepos (raw CBOR/CAR).
ATPROTO_FIREHOSE_TRANSPORT=jetstream
ATPROTO_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
ATPROTO_RELAY_URL=wss://bsky.network/xrpc/com.atproto.sync.subscribeRepos
# Comma-separated lexicon collections to ingest (default app.bsky.feed.post).
ATPROTO_WANTED_COLLECTIONS=app.bsky.feed.post
# Volume control — the full firehose is millions/day. Process this fraction
# (0..1) of matching posts; and/or restrict to specific author DIDs.
ATPROTO_SAMPLE_RATE=1
ATPROTO_AUTHOR_ALLOWLIST=
# Backpressure: shed load when the moderation queue exceeds HIGH, resume at LOW.
ATPROTO_BACKPRESSURE_HIGH=5000
ATPROTO_BACKPRESSURE_LOW=1000
ATPROTO_CURSOR_PERSIST_EVERY=200
ATPROTO_BRIDGE_CONCURRENCY=4

# Consume external labelers (inbound moderation feed). Comma-separated entries,
# each a labeler DID (did:exprsn:… / did:web:…) resolved to its #atproto_labeler
# endpoint, or a full wss:// subscribeLabels URL. Empty = consume nothing.
ATPROTO_SUBSCRIBE_LABELERS=
# Drop inbound labels whose signature fails to verify (else store flagged).
ATPROTO_CONSUME_REQUIRE_VERIFIED=false
# TRUSTED labelers (subset of the above) whose verified labels drive our AI
# moderation + auto-action. e.g. did:plc:ar7c4by46qjdydhdevvrndac (Bluesky mod).
ATPROTO_TRUSTED_LABELERS=
# Label values that auto-hide content when a trusted labeler applies them.
ATPROTO_AUTOACTION_VALUES=!hide,porn,sexual,nudity,csam,child-sexual-abuse-material
# Public AppView used to fetch post text for the AI pass on trusted labels.
# The AI pass is best-effort: if it errors or no AI provider is configured, the
# auto-action (!hide for severe values) still applies. To enable the AI pass set
# the moderator providers above (e.g. CLAUDE_ENABLED=true + CLAUDE_API_KEY, or
# OPENAI_ENABLED=true + OPENAI_API_KEY).
ATPROTO_APPVIEW_URL=https://public.api.bsky.app

# Feed generator (app.bsky.feed.generator) — an Exprsn-curated, label-filtered
# feed Bluesky clients can subscribe to. Publish the record with the rkey below.
ATPROTO_FEED_RKEY=exprsn-clean
ATPROTO_FEED_NAME=Exprsn Clean
ATPROTO_FEED_DESCRIPTION=Exprsn-moderated feed: ingested posts carrying our moderation labels, with hidden content removed.

# Labeler identity (run `npm run atproto:provision` to mint one).
# DID method:
#   exprsn — Exprsn's self-certifying method (did:exprsn:<pubkey>); resolvable
#            offline, used for the native Exprsn label mesh (ingest + outgest).
#   web    — did:web from ATPROTO_LABELER_HOST; needed for PUBLIC Bluesky interop
#            (their AppView resolves did:web / did:plc, not did:exprsn).
#   plc    — pre-created did:plc (set ATPROTO_DID below).
ATPROTO_DID_METHOD=exprsn
# Leave ATPROTO_DID unset for did:exprsn (derived from the signing key) and
# did:web (derived from ATPROTO_LABELER_HOST); set it for a pre-created did:plc.
ATPROTO_DID=
# Public host the labeler is reachable at (did:web id + service endpoint).
ATPROTO_LABELER_HOST=localhost:8443
# Declared label values (app.bsky.labeler.service).
ATPROTO_LABEL_VALUES=spam,nsfw,toxic,hate,violence,!warn,!hide
# Signing key: the provision script prints a hex private key for the env var
# named here. NEVER commit it; prefer a vault/KMS reference in production.
ATPROTO_SIGNING_KEY_REF=ATPROTO_SIGNING_KEY
ATPROTO_SIGNING_KEY=

# did:plc publishing (only when ATPROTO_DID_METHOD=plc). The labeler lives in a
# PDS account; provisioning publishes app.bsky.labeler.service and runs a PLC op
# (which needs an email token — the script guides the 2-step).
ATPROTO_PDS_URL=
ATPROTO_PDS_HANDLE=
ATPROTO_PDS_PASSWORD=
ATPROTO_PLC_TOKEN=
ATPROTO_PLC_DIRECTORY_URL=https://plc.directory

# Per-user did:exprsn derivation secret (HMAC seed). Falls back to
# SERVICE_TOKEN_SECRET. Changing it re-keys every user's did:exprsn.
ATPROTO_USER_DID_SECRET=

# ---- FileVault storage -----------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# IPFS_API_URL=

# ---- Elasticsearch (spark / timeline / filevault) --------------------------
ELASTICSEARCH_NODE=http://localhost:9200

# ---- Live streaming (Cloudflare) ------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# ============================================================================
# Docker infrastructure stack (docker-compose.yml + `npm run infra:*`)
# Compose auto-loads this file; these values feed both the containers and the
# Node process. Ports are host-side and can be remapped to avoid conflicts.
# ============================================================================

# ---- RabbitMQ (extras broker) ---------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_ENABLED=true
RABBITMQ_USER=exprsn
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---- nginx edge (front of the :8443 Node gateway) -------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- OpenLDAP (directory; ca module / ldapjs) -----------------------------
LDAP_ORG=Exprsn
LDAP_DOMAIN=exprsn.local
LDAP_ADMIN_PASSWORD=change_me
LDAP_PORT=389
LDAPS_PORT=636

# ---- BIND9 DNS ------------------------------------------------------------
DNS_PORT=53

# ---- Kerberos (KDC + kadmin) ----------------------------------------------
KRB5_REALM=EXPRSN.LOCAL
KRB5_KDC=kerberos
KRB5_ADMIN_PASSWORD=change_me
KRB_KDC_PORT=88
KRB_KADMIN_PORT=749

# ---- Dovecot (IMAP/POP3) --------------------------------------------------
IMAP_PORT=143
IMAPS_PORT=993
POP3_PORT=110
POP3S_PORT=995

# ---- Extensibility framework (plugins + low-code) -------------------------
# Both default OFF: the modules load inert and the hook bus is a no-op until
# enabled, so they never touch the MVP critical path. See PLUGINS_PLAN.md /
# PLUGINS_DECISIONS.md.
PLUGINS_ENABLED=false
# Sandboxed native-JS (`script` kind) execution — the highest-risk surface, so
# it is gated SEPARATELY from PLUGINS_ENABLED. Runs untrusted JS in a worker
# thread; all its I/O is brokered through the token/CA gateway.
PLUGINS_SCRIPT_ENABLED=false
# Allow webhook/endpoint targets on private/loopback ranges (dev only — SSRF).
PLUGINS_WEBHOOK_ALLOW_PRIVATE=false
# Outbound webhook delivery tuning.
# PLUGINS_WEBHOOK_ATTEMPTS=3
# PLUGINS_WEBHOOK_BREAKER_THRESHOLD=5
# PLUGINS_WEBHOOK_BREAKER_COOLDOWN_MS=60000
# Hook-bus re-entrancy guard (plugin-induced event storms are dropped past this).
# PLUGINS_MAX_DISPATCH_DEPTH=3
# Low-code app builder (entities/forms/flows). Reuses the plugins trust layer.
LOWCODE_ENABLED=false
# Gateway base URL used by the sandbox broker to route brokered calls back
# through the single HTTPS edge (defaults to https://localhost:<HTTPS_PORT>).
# PUBLIC_BASE_URL=https://localhost:8443

# ---- Cortex (local-LLM agents / guardrails, FEAT-021) ----------------------
# Defaults OFF: the module loads inert (health only, everything else 503) so it
# never touches the critical path until explicitly enabled.
CORTEX_ENABLED=false
# OpenAI-compatible llama.cpp router the module runs inference against.
# CORTEX_LLM_BASE_URL=http://127.0.0.1:8080/v1
# CORTEX_BRAIN_MODEL=qwen3-30b-a3b
# CORTEX_JUDGE_MODEL=qwen3-30b-a3b
# Filesystem root for per-task workspaces and the CS knowledge base.
# CORTEX_DATA_DIR=./data/cortex
# Bull worker concurrency for agent tasks / in-process LLM request semaphore.
# CORTEX_TASK_CONCURRENCY=1
# CORTEX_LLM_CONCURRENCY=2
# Python custom-tool execution is ARBITRARY CODE EXECUTION on the worker host
# (python3 -I subprocess; no filesystem/network sandbox). Gated SEPARATELY from
# CORTEX_ENABLED, default off; leave off in production until real sandboxing
# lands (see FEAT-021 notes).
CORTEX_PYTHON_TOOLS_ENABLED=false
# Allow http-kind tool targets on private/loopback ranges (dev only — SSRF).
CORTEX_TOOL_ALLOW_PRIVATE_HOSTS=false
# Layer the moderator module's screen on top of local guardrails (fail-open).
CORTEX_MODERATE=false
# Chat-completion Redis cache TTL (seconds).
# CORTEX_CACHE_TTL=3600

# ---- strongSwan / Wireshark run on host networking (no port vars) ---------
TZ=UTC
