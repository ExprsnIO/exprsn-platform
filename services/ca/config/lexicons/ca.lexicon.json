      "method": "GET",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 100 }
    },
    {
      "id": "certificates.status",
      "type": "query",
      "description": "Get a certificate's live revocation/OCSP/CRL status",
      "path": "/api/certificates/:id/status",
      "method": "GET",
      "auth": "required",
