{
  "name": "exprsn-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Exprsn platform — 10 domain modules behind one HTTPS gateway",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "gen:certs": "node scripts/gen-certs.js",
    "pki:gen": "node scripts/gen-pki.js",
    "db:bootstrap": "node src/db/migrate.js",
    "db:migrate": "node scripts/migrate-sync.js",
    "db:migrate:raw": "node scripts/migrate-modules.js",
    "db:check": "node scripts/check-drift.js",
    "db:backup": "bash scripts/backup/pg-backup.sh",
    "db:restore": "bash scripts/backup/pg-restore.sh",
    "seed:timeline": "node scripts/seed/timeline-demo.js",
    "seed:moderation": "node scripts/seed/moderation-demo.js",
    "seed:plugins": "node scripts/seed/plugins-demo.js",
    "seed:lowcode": "node scripts/seed/lowcode-demo.js",
    "seed:modbot": "node scripts/seed/modbot-lowcode.js",
    "lowcode": "node scripts/lowcode-tui.js",
    "lowcode:bridge": "node scripts/lowcode-bridge-tui.js",
    "lowcode:clarify": "node scripts/lowcode-clarify.js",
    "plan:plugins": "node scripts/plugin-planner.js",
    "lint": "eslint src services --ext .js",
    "test:all": "node scripts/test-all.js",
    "worker:timeline": "node services/timeline/src/worker.js",
    "worker:prefetch": "PREFETCH_ROLE=worker node services/prefetch/src/worker.js",
    "worker:atproto": "node services/atproto/src/worker.js",
    "worker:live": "node services/live/src/worker.js",
    "atproto:provision": "node services/atproto/scripts/provision-identity.js",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test",
    "web:e2e": "npm --prefix web run e2e",
    "infra:pull": "docker compose --profile extras --profile optional pull",
    "infra:up": "docker compose up -d",
    "infra:up:all": "docker compose --profile extras --profile optional up -d",
    "infra:start": "npm run infra:pull && npm run infra:up:all",
    "infra:down": "docker compose --profile extras --profile optional down",
    "infra:ps": "docker compose --profile extras --profile optional ps",
    "infra:logs": "docker compose --profile extras --profile optional logs -f"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.10.0",
    "@atproto/crypto": "^0.4.1",
    "@aws-sdk/client-ses": "^3.450.0",
    "@elastic/elasticsearch": "^8.11.0",
    "@exprsn/shared": "file:./shared",
    "@ipld/car": "^5.3.0",
    "@ipld/dag-cbor": "^9.2.0",
    "@sendgrid/mail": "^7.7.0",
    "@socket.io/redis-adapter": "^8.2.1",
    "amqplib": "^0.10.4",
    "archiver": "^6.0.1",
    "argon2": "^0.31.2",
    "aws-sdk": "^2.1519.0",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "bull-board": "^2.1.3",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "connect-pg-simple": "^9.0.1",
    "connect-redis": "^7.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "diff": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "emoji-regex": "^10.3.0",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.17.3",
    "file-type": "^18.7.0",
    "form-data": "^4.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ical-generator": "^10.0.0",
    "ioredis": "^5.4.1",
    "ipfs-http-client": "^60.0.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "ldapjs": "^3.0.7",
    "linkify-it": "^5.0.0",
    "mailgun.js": "^9.3.0",
    "mime-types": "^2.1.35",
    "moment-timezone": "^0.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multiformats": "^13.1.0",
    "node-cron": "^4.2.1",
    "node-forge": "^1.3.3",
    "nodemailer": "^6.9.8",
    "oauth2-server": "^3.1.1",
    "openai": "^4.24.1",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.7.0",
    "passport-saml": "^3.2.4",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.3",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.11",
    "sanitize-html": "^2.17.0",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "sharp": "^0.33.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.7.5",
    "speakeasy": "^2.0.0",
    "stripe": "^22.2.0",
    "twilio": "^6.0.2",
    "uint8arrays": "^5.1.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^6.3.3"
  }
}
