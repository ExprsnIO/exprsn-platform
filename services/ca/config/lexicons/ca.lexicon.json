{
  "lexicon": 1,
  "id": "io.exprsn.ca",
  "defs": {
    "main": {
      "type": "record",
      "description": "Certificate Authority service lexicon for Bridge integration (X.509 certs, capability tokens, OCSP, CRL, ACME)",
      "key": "io.exprsn.ca"
    }
  },
  "routes": [
    {
      "id": "tickets.generate",
      "type": "procedure",
      "description": "Generate a short-lived single-use ticket for the current session",
      "path": "/tickets/generate",
      "method": "POST",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 20 }
    },
    {
      "id": "tokens.generate",
      "type": "procedure",
      "description": "Generate a capability token bound to a certificate",
      "path": "/api/tokens/generate",
      "method": "POST",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 10 },
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "certificateId": { "type": "string", "format": "uuid", "required": true },
            "permissions": { "type": "object", "required": true },
            "resource": { "$ref": "#/defs/resourceRef", "required": true },
            "expiryType": { "type": "string", "enum": ["time", "uses"] },
            "expiresAt": { "type": "integer" },
            "maxUses": { "type": "integer" },
            "notBefore": { "type": "integer" },
            "data": { "type": "object" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "token": { "$ref": "#/defs/token" }
          }
        }
      }
    },
    {
      "id": "tokens.validate",
      "type": "procedure",
      "description": "Validate a token and check its permissions against a resource",
      "path": "/api/tokens/validate",
      "method": "POST",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 20 },
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "token": { "type": "string" },
            "tokenId": { "type": "string", "format": "uuid" },
            "requiredPermissions": { "type": "object" },
            "resource": { "type": "string" },
            "resourceValue": { "type": "string" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "valid": { "type": "boolean" },
            "errors": { "type": "array", "items": { "type": "string" } },
            "token": { "$ref": "#/defs/token" }
          }
        }
      }
    },
    {
      "id": "tokens.revoke",
      "type": "procedure",
      "description": "Revoke a capability token",
      "path": "/api/tokens/revoke",
      "method": "POST",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 20 }
    },
    {
      "id": "tokens.list",
      "type": "query",
      "description": "List the current user's tokens",
      "path": "/api/tokens",
      "method": "GET",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 100 }
    },
    {
      "id": "tokens.refresh",
      "type": "procedure",
      "description": "Refresh a token's expiry",
      "path": "/api/tokens/:id/refresh",
      "method": "POST",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 20 }
    },
    {
      "id": "tokens.introspect",
      "type": "query",
      "description": "Introspect a token by id",
      "path": "/api/tokens/:id/introspect",
      "method": "GET",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 100 }
    },
    {
      "id": "certificates.generateRoot",
      "type": "procedure",
      "description": "Generate a root CA certificate",
      "path": "/api/certificates/generate-root",
      "method": "POST",
      "auth": "admin",
      "rateLimit": { "window": 60000, "max": 10 }
    },
    {
      "id": "certificates.generateIntermediate",
      "type": "procedure",
