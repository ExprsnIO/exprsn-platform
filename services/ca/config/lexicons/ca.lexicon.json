      "rateLimit": { "window": 60000, "max": 20 }
    },
    {
      "id": "admin.certificates.download",
      "type": "query",
      "description": "Download a certificate (admin)",
      "path": "/admin/api/certificates/:id/download",
      "method": "GET",
