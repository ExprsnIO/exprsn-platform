        "window": 60000,
        "max": 10
      }
    },
    {
      "id": "metrics.get",
      "type": "query",
      "description": "Get moderation metrics for a period",
      "path": "/api/metrics",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "metrics.export",
      "type": "query",
      "description": "Export moderation metrics as CSV",
      "path": "/api/metrics/export",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 10
      }
    },
    {
      "id": "actions.recent",
      "type": "query",
      "description": "List recent moderation actions",
      "path": "/api/actions/recent",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "actions.get",
      "type": "query",
      "description": "Get a moderation action",
      "path": "/api/actions/:id",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "actions.byContent",
      "type": "query",
      "description": "List moderation actions for a content item",
      "path": "/api/actions/content/:contentType/:contentId",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "actions.execute",
      "type": "procedure",
      "description": "Execute a moderation action on content",
      "path": "/api/actions/execute",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "actions.providersStatus",
      "type": "query",
      "description": "Get action-provider connectivity status",
      "path": "/api/actions/providers/status",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "config.get",
      "type": "query",
