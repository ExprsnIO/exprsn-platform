    "user:updated",
    "user:deleted",
    "group:created",
    "group:updated",
    "role:created",
    "system:health",
    "moderation:event",
    "system:notification"
   ],
   "emit": [
    "certificate:subscribe",
    "certificate:unsubscribe",
    "token:subscribe",
    "token:unsubscribe",
    "dashboard:subscribe",
    "ping"
   ],
   "noUi": {
    "pong": "keepalive only",
    "ping": "keepalive only"
   }
  },
  "/spark": {
   "on": [
    "joined:conversation",
    "left:conversation",
    "error",
    "new:message",
    "typing:start",
    "typing:stop",
    "read:receipt",
    "new:reaction",
    "message:edited",
    "message:deleted",
    "user:status",
    "message:new",
    "message:pinned",
    "message:unpinned",
    "message:reply",
    "participant:added",
    "message:redacted"
   ],
   "emit": [
    "join:conversation",
    "leave:conversation",
    "send:message",
    "typing:start",
    "typing:stop",
    "mark:read",
    "add:reaction",
    "edit:message",
    "delete:message",
    "presence:update"
   ]
  },
  "/vault": {
   "on": [
    "connected",
    "pong",
    "token:event",
    "policy:event",
    "security:alert",
    "stats:update",
    "cache:stats",
    "audit:log",
    "notification",
    "server:shutdown"
   ],
   "emit": [
    "subscribe",
    "unsubscribe",
    "ping"
   ],
   "noUi": {
    "pong": "keepalive only",
    "ping": "keepalive only",
    "connected": "handshake ack"
   }
  },
  "/timeline": {
   "on": [
    "subscribed:timeline",
    "unsubscribed:timeline",
    "subscribed:group",
    "unsubscribed:group",
    "error",
    "new:post",
    "post:liked",
    "post:commented",
    "post:retracted",
    "post:created",
    "post:updated",
    "post:deleted"
   ],
   "emit": [
    "subscribe:timeline",
    "unsubscribe:timeline",
    "subscribe:group",
    "unsubscribe:group"
   ],
   "noUi": {
    "subscribed:timeline": "ack only",
    "unsubscribed:timeline": "ack only",
    "subscribed:group": "ack only",
    "unsubscribed:group": "ack only"
   }
  },
  "/moderation": {
   "on": [
    "queue:new_item",
    "queue:high_priority",
    "queue:item_claimed",
    "queue:item_completed",
    "appeal:new",
    "appeal:reviewed",
