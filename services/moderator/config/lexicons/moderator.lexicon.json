    {
      "id": "appeals.stats",
      "type": "query",
      "description": "Appeals summary statistics",
      "path": "/api/appeals/stats/summary",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "appeals.byCase",
      "type": "query",
      "description": "Get appeals for a moderation case",
      "path": "/api/appeals/case/:moderationItemId",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "appeals.get",
      "type": "query",
      "description": "Get an appeal",
      "path": "/api/appeals/:id",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "appeals.review",
      "type": "procedure",
      "description": "Review (approve/deny) an appeal",
      "path": "/api/appeals/:id/review",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "workflows.list",
      "type": "query",
      "description": "List moderation workflows",
      "path": "/api/workflows",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "workflows.active",
      "type": "query",
      "description": "List active (enabled) workflows",
      "path": "/api/workflows/active",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "workflows.create",
      "type": "procedure",
      "description": "Create a moderation workflow",
      "path": "/api/workflows",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "workflows.update",
      "type": "procedure",
      "description": "Update a workflow",
      "path": "/api/workflows/:id",
      "method": "PUT",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "workflows.delete",
      "type": "procedure",
      "description": "Delete a workflow",
      "path": "/api/workflows/:id",
      "method": "DELETE",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "workflows.execute",
      "type": "procedure",
      "description": "Execute a workflow",
      "path": "/api/workflows/:id/execute",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 10
      }
    },
    {
      "id": "workflows.trigger",
      "type": "procedure",
      "description": "Trigger a workflow by id",
      "path": "/api/workflows/trigger/:id",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 10
      }
    },
    {
      "id": "workflows.execution",
      "type": "query",
      "description": "Get a workflow execution record",
      "path": "/api/workflows/executions/:executionId",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "workflows.callback",
      "type": "procedure",
      "description": "Workflow step callback ingest",
      "path": "/api/workflows/callback",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 30
      }
    },
    {
      "id": "workflows.setupDefaults",
      "type": "procedure",
      "description": "Provision default workflows",
      "path": "/api/workflows/setup-defaults",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 10
      }
    },
    {
      "id": "workflows.moderateAuto",
      "type": "procedure",
      "description": "Auto-moderate content through the workflow engine",
      "path": "/api/workflows/moderate/auto",
      "method": "POST",
      "auth": "none",
