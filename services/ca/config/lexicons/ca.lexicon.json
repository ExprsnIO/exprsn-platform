      "path": "/api/certificates/generate-intermediate",
      "method": "POST",
      "auth": "admin",
      "rateLimit": { "window": 60000, "max": 10 }
    },
    {
      "id": "certificates.generateCodeSigning",
      "type": "procedure",
      "description": "Generate a code-signing certificate",
      "path": "/api/certificates/generate-code-signing",
      "method": "POST",
      "auth": "admin",
      "rateLimit": { "window": 60000, "max": 10 }
    },
    {
      "id": "certificates.generate",
      "type": "procedure",
      "description": "Generate an entity/leaf certificate",
      "path": "/api/certificates/generate",
      "method": "POST",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 10 }
    },
    {
      "id": "certificates.list",
