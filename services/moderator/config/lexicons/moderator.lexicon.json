{
  "lexicon": 1,
  "id": "io.exprsn.moderator",
  "defs": {
    "main": {
      "type": "record",
      "description": "Moderator service lexicon for Bridge integration",
      "key": "io.exprsn.moderator"
    }
  },
  "routes": [
    {
      "id": "health.main",
      "type": "query",
      "description": "Service health check",
      "path": "/health",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 300
      }
    },
    {
      "id": "health.db",
      "type": "query",
      "description": "Database health check",
      "path": "/health/db",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 300
      }
    },
    {
      "id": "health.aiProviders",
      "type": "query",
      "description": "AI provider connectivity health check",
      "path": "/health/ai-providers",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 300
      }
    },
    {
      "id": "moderate.content",
      "type": "procedure",
      "description": "Submit a content item for moderation analysis",
      "path": "/api/moderate/content",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 10
      },
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "contentType": {
              "type": "string",
              "required": true,
              "enum": ["text", "image", "video", "audio", "post", "comment", "message", "profile", "file"]
            },
            "contentId": {
              "type": "string",
              "required": true
            },
            "sourceService": {
              "type": "string",
              "required": true
            },
            "userId": {
              "type": "string",
              "format": "uuid",
              "required": true
            },
            "contentText": {
              "type": "string"
            },
            "contentUrl": {
              "type": "string",
              "format": "uri"
            },
            "contentMetadata": {
              "type": "object"
            },
            "aiProvider": {
              "type": "string",
              "enum": ["claude", "openai", "deepseek", "local"]
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "case": { "$ref": "#/defs/moderationCase" },
            "verdict": { "$ref": "#/defs/verdict" }
          }
        }
      }
    },
    {
      "id": "moderate.status",
      "type": "query",
      "description": "Get moderation status for a content item",
      "path": "/api/moderate/status/:sourceService/:contentType/:contentId",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "moderate.batch",
      "type": "procedure",
      "description": "Submit a batch of content items for moderation (1-100)",
      "path": "/api/moderate/batch",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 10
      }
    },
    {
      "id": "queue.pending",
      "type": "query",
      "description": "List pending review-queue items",
      "path": "/api/queue/pending",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "queue.list",
      "type": "query",
      "description": "List review-queue items by priority/status",
      "path": "/api/queue",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "queue.get",
      "type": "query",
      "description": "Get a review-queue item",
      "path": "/api/queue/:id",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "queue.approve",
      "type": "procedure",
      "description": "Approve a queued content item",
      "path": "/api/queue/:itemId/approve",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 30
      }
    },
    {
      "id": "queue.reject",
      "type": "procedure",
      "description": "Reject a queued content item",
      "path": "/api/queue/:itemId/reject",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 30
      }
    },
    {
      "id": "queue.analyze",
      "type": "procedure",
      "description": "Run AI analysis on a queued content item",
      "path": "/api/queue/:id/analyze",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 10
      }
    },
    {
      "id": "queue.warn",
      "type": "procedure",
      "description": "Issue a warning action on a queued item",
      "path": "/api/queue/:id/warn",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 30
      }
    },
    {
      "id": "queue.remove",
      "type": "procedure",
      "description": "Remove content for a queued item",
      "path": "/api/queue/:id/remove",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 30
      }
    },
    {
      "id": "queue.ban",
      "type": "procedure",
      "description": "Ban the user for a queued item",
      "path": "/api/queue/:id/ban",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "queue.skip",
      "type": "procedure",
      "description": "Skip/deprioritize a queued item",
      "path": "/api/queue/:id/skip",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 30
      }
    },
    {
      "id": "reports.create",
      "type": "procedure",
      "description": "File a user report against content",
      "path": "/api/reports",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "reports.get",
      "type": "query",
      "description": "Get a report",
      "path": "/api/reports/:id",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "reports.resolve",
      "type": "procedure",
      "description": "Resolve a report",
      "path": "/api/reports/:id/resolve",
      "method": "PUT",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "rules.list",
      "type": "query",
      "description": "List moderation rules",
      "path": "/api/rules",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "rules.get",
      "type": "query",
      "description": "Get a moderation rule",
      "path": "/api/rules/:id",
      "method": "GET",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "rules.create",
      "type": "procedure",
      "description": "Create a moderation rule",
      "path": "/api/rules",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      },
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "required": true
            },
            "action": {
              "type": "string",
              "required": true,
              "enum": ["auto_approve", "approve", "reject", "hide", "remove", "warn", "flag", "escalate", "require_review"]
            },
            "conditions": {
              "type": "object",
              "required": true
            },
            "description": {
              "type": "string"
            },
            "appliesTo": {
              "type": "array",
              "items": { "type": "string" }
            },
            "sourceServices": {
              "type": "array",
              "items": { "type": "string" }
            },
            "thresholdScore": {
              "type": "integer"
            },
            "enabled": {
              "type": "boolean"
            },
            "priority": {
              "type": "integer"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "rule": { "$ref": "#/defs/moderationRule" }
          }
        }
      }
    },
    {
      "id": "rules.update",
      "type": "procedure",
      "description": "Update a moderation rule",
      "path": "/api/rules/:id",
      "method": "PUT",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "rules.delete",
      "type": "procedure",
      "description": "Delete a moderation rule",
      "path": "/api/rules/:id",
      "method": "DELETE",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "rules.test",
      "type": "procedure",
      "description": "Test a moderation rule against sample content",
      "path": "/api/rules/:id/test",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "rules.enable",
      "type": "procedure",
      "description": "Enable a moderation rule",
      "path": "/api/rules/:id/enable",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "rules.disable",
      "type": "procedure",
      "description": "Disable a moderation rule",
      "path": "/api/rules/:id/disable",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "appeals.create",
      "type": "procedure",
      "description": "File an appeal against a moderation decision",
      "path": "/api/appeals",
      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "appeals.list",
      "type": "query",
      "description": "List appeals",
