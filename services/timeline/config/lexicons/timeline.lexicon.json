{
  "lexicon": 1,
  "id": "io.exprsn.timeline",
  "defs": {
    "main": {
      "type": "record",
      "description": "Timeline service lexicon for Bridge integration",
      "key": "io.exprsn.timeline"
    }
  },
  "routes": [
    {
      "id": "posts.create",
      "type": "procedure",
      "description": "Create a new post",
      "path": "/api/posts/",
      "method": "POST",
      "auth": "required",
      "rateLimit": {
        "window": 60000,
        "max": 20
      },
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "required": true,
              "maxLength": 4000
            },
            "mediaIds": {
              "type": "array",
              "items": { "type": "string", "format": "uuid" }
            },
            "visibility": {
              "type": "string",
              "enum": ["public", "followers", "private"]
            },
            "replyTo": { "type": "string", "format": "uuid" },
            "quoteOf": { "type": "string", "format": "uuid" },
            "groupId": { "type": "string", "format": "uuid" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "post": { "$ref": "#/defs/post" }
          }
        }
      }
    },
    {
      "id": "posts.get",
      "type": "query",
      "description": "Get a post by id",
      "path": "/api/posts/:id",
      "method": "GET",
      "auth": "required",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
