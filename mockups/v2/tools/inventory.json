   "emit": []
  },
  "/notifications": {
   "on": [
    "notification",
    "moderation_notification",
    "appeal:new",
    "appeal:reviewed"
   ],
   "emit": []
  },
  "/live": {
   "on": [
    "viewer-count-updated",
    "viewer-joined",
    "viewer-left",
    "chat-history",
    "stream-chat-message",
    "participant-joined",
    "existing-participants",
    "participant-state-changed",
    "participant-left",
    "signal",
    "offer",
    "answer",
    "ice-candidate",
    "room-closed",
    "error",
    "stream-started",
    "stream-ended",
    "stream-deleted"
   ],
   "emit": [
    "join-stream",
    "leave-stream",
    "stream-chat-message",
    "join-room",
    "leave-room",
    "update-participant-state",
    "signal",
    "offer",
    "answer",
    "ice-candidate"
   ]
  },
