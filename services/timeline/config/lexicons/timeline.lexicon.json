      "description": "Subscribe to the global timeline room",
      "auth": "required"
    },
    {
      "id": "unsubscribe:timeline",
      "direction": "client->server",
      "description": "Unsubscribe from the global timeline room",
      "auth": "required"
    },
    {
      "id": "subscribe:group",
      "direction": "client->server",
      "description": "Subscribe to a group's timeline room",
      "auth": "required"
    },
    {
      "id": "unsubscribe:group",
      "direction": "client->server",
      "description": "Unsubscribe from a group's timeline room",
      "auth": "required"
    },
    {
      "id": "subscribed:timeline",
      "direction": "server->client",
      "description": "Acknowledgement of timeline subscription",
      "auth": "required"
    },
    {
      "id": "unsubscribed:timeline",
      "direction": "server->client",
      "description": "Acknowledgement of timeline unsubscription",
      "auth": "required"
    },
    {
      "id": "new:post",
      "direction": "server->client",
