{
 "_about": "Every Socket.IO event and REST route of the platform (from code, 2026-09-29; see TASK-074). coverage.js checks each item is bound to at least one mockup contract, or carries a noUi reason.",
 "sockets": {
  "/_health": {
   "on": [
    "health"
   ],
   "emit": []
  },
  "/_admin": {
   "on": [
    "health",
    "config:changed"
   ],
   "emit": []
  },
  "/ca": {
   "on": [
    "pong",
    "certificate:created",
    "certificate:revoked",
    "certificates:updated",
    "token:created",
    "token:revoked",
    "token:validated",
    "token:used",
    "tokens:updated",
    "user:login",
    "dashboard:stats",
