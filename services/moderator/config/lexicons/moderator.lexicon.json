      "method": "POST",
      "auth": "none",
      "rateLimit": {
        "window": 60000,
        "max": 20
      }
    },
    {
      "id": "notifications.create",
      "type": "procedure",
      "description": "Service ingest: push a notification for a user (per-service HMAC)",
      "path": "/api/notifications",
      "method": "POST",
      "auth": "required",
      "rateLimit": {
        "window": 60000,
        "max": 30
      }
    },
    {
      "id": "notifications.list",
      "type": "query",
      "description": "List the caller's persisted notifications",
      "path": "/api/notifications",
      "method": "GET",
      "auth": "required",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "notifications.unreadCount",
      "type": "query",
      "description": "Get the caller's unread notification count",
      "path": "/api/notifications/unread-count",
      "method": "GET",
      "auth": "required",
      "rateLimit": {
        "window": 60000,
        "max": 100
      }
    },
    {
      "id": "notifications.readAll",
      "type": "procedure",
      "description": "Mark all the caller's notifications read",
      "path": "/api/notifications/read-all",
      "method": "POST",
      "auth": "required",
      "rateLimit": {
        "window": 60000,
        "max": 30
      }
    },
    {
      "id": "notifications.read",
      "type": "procedure",
      "description": "Mark one notification read",
      "path": "/api/notifications/:id/read",
      "method": "POST",
      "auth": "required",
      "rateLimit": {
        "window": 60000,
        "max": 30
      }
    },
    {
      "id": "notifications.delete",
      "type": "procedure",
      "description": "Dismiss one notification",
      "path": "/api/notifications/:id",
      "method": "DELETE",
      "auth": "required",
      "rateLimit": {
        "window": 60000,
        "max": 30
      }
    },
    {
      "id": "notifications.clear",
      "type": "procedure",
      "description": "Clear all the caller's notifications",
      "path": "/api/notifications",
      "method": "DELETE",
      "auth": "required",
      "rateLimit": {
        "window": 60000,
        "max": 30
      }
    }
  ],
  "events": [
    {
      "id": "connection",
      "namespace": "/moderation",
      "direction": "server-side",
      "description": "Socket connects; joins room moderators (and admins if handshake.query.role=admin). No token auth.",
      "auth": "none"
    },
    {
      "id": "disconnect",
      "namespace": "/moderation",
      "direction": "client->server",
      "description": "Moderator socket disconnects",
      "auth": "none"
    },
    {
      "id": "queue:update",
      "namespace": "/moderation",
      "direction": "server->client",
      "description": "Review-queue change broadcast to the moderators/admins rooms",
      "auth": "none"
    },
    {
      "id": "case:update",
      "namespace": "/moderation",
      "direction": "server->client",
      "description": "Moderation case status/action change broadcast to the moderators/admins rooms",
      "auth": "none"
    },
    {
      "id": "handshake",
      "namespace": "/notifications",
      "direction": "server-side",
      "description": "Namespace use() validates a CA token (read:true) and requires data.valid && data.userId before connect",
      "auth": "required"
    },
    {
      "id": "connection",
      "namespace": "/notifications",
      "direction": "server-side",
      "description": "Authenticated socket connects; joins room user:{userId} from the validated token",
      "auth": "required"
    },
    {
      "id": "disconnect",
      "namespace": "/notifications",
      "direction": "client->server",
      "description": "Notifications socket disconnects",
      "auth": "required"
    },
    {
      "id": "notification",
      "namespace": "/notifications",
      "direction": "server->client",
      "description": "A persisted notification delivered live to room user:{userId} (emitted by the HTTP ingest route)",
      "auth": "required"
    }
  ],
  "types": {
    "moderationCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "contentType": {
          "type": "string",
          "enum": ["text", "image", "video", "audio", "post", "comment", "message", "profile", "file"]
        },
        "contentId": {
          "type": "string"
        },
        "sourceService": {
          "type": "string"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "contentText": {
          "type": "string"
        },
        "contentUrl": {
          "type": "string",
          "format": "uri"
        },
        "contentMetadata": {
          "type": "object"
        },
        "riskScore": {
          "type": "integer"
        },
        "riskLevel": {
          "type": "string",
          "enum": ["safe", "low", "medium", "high", "critical"]
        },
        "scores": {
          "type": "object",
          "properties": {
            "toxicity": { "type": "integer" },
            "nsfw": { "type": "integer" },
            "spam": { "type": "integer" },
            "violence": { "type": "integer" },
            "hateSpeech": { "type": "integer" },
            "sentiment": { "type": "integer" }
          }
