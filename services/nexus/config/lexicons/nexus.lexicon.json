    {
      "id": "groups.create",
      "type": "procedure",
      "description": "Create a new group",
      "path": "/api/groups",
      "method": "POST",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 20 },
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 2, "maxLength": 255 },
            "description": { "type": "string", "maxLength": 5000 },
            "visibility": { "type": "string", "enum": ["public", "private", "secret"] },
            "joinMode": { "type": "string", "enum": ["open", "request", "invite"] },
            "governanceModel": { "type": "string" },
            "governanceRules": { "type": "object" },
            "category": { "type": "string", "maxLength": 100 },
            "tags": { "type": "array", "items": { "type": "string", "maxLength": 50 } },
            "avatarUrl": { "type": "string", "format": "uri", "maxLength": 500 },
            "bannerUrl": { "type": "string", "format": "uri", "maxLength": 500 },
            "maxMembers": { "type": "integer", "minimum": 1 },
            "location": { "type": "string" },
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "website": { "type": "string", "format": "uri", "maxLength": 500 },
            "metadata": { "type": "object" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "group": { "$ref": "#/defs/group" }
          }
        }
      }
    },
