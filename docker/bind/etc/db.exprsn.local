$TTL 604800
@   IN  SOA ns1.exprsn.local. admin.exprsn.local. (
              1         ; Serial
         604800         ; Refresh
          86400         ; Retry
        2419200         ; Expire
         604800 )       ; Negative Cache TTL
;
@       IN  NS  ns1.exprsn.local.
ns1     IN  A   127.0.0.1
gateway IN  A   127.0.0.1
ldap    IN  A   127.0.0.1
db      IN  A   127.0.0.1
search  IN  A   127.0.0.1
mq      IN  A   127.0.0.1
mail    IN  A   127.0.0.1
