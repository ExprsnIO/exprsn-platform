    {
      "id": "health.main",
      "type": "query",
      "description": "Service health check",
      "path": "/health",
      "method": "GET",
      "auth": "none",
      "rateLimit": { "window": 60000, "max": 300 }
    },
    {
      "id": "health.db",
      "type": "query",
      "description": "Database health check",
      "path": "/health/db",
      "method": "GET",
      "auth": "none",
      "rateLimit": { "window": 60000, "max": 300 }
    },
    {
      "id": "health.cache",
      "type": "query",
      "description": "Cache (Redis) health check",
      "path": "/health/cache",
      "method": "GET",
      "auth": "none",
      "rateLimit": { "window": 60000, "max": 300 }
    },
    {
      "id": "health.all",
