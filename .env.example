# ============================================================================
# Exprsn Platform — unified configuration
# Copy to .env and fill in secrets. One process, one HTTPS port, one database.
# ============================================================================

NODE_ENV=development

# ---- Development auth bypass (FAIL-CLOSED; never enable in production) -----
# Bypass only works when ALL are true: NODE_ENV=development, DEV_BYPASS=true,
# DEV_BYPASS_SECRET set (>= 32 chars) and sent as the x-dev-bypass-secret
# header, AND the request comes from loopback (127.0.0.1/::1).
# DEV_BYPASS=true
# DEV_BYPASS_SECRET=   # generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- HTTPS edge (the ONLY exposed port) ------------------------------------
HOST=0.0.0.0
HTTPS_PORT=8443
HTTP_REDIRECT_PORT=8080      # plain HTTP -> 301 to HTTPS. 0 disables.
PUBLIC_HOST=localhost:8443
# Comma-separated allowlist of browser origins permitted by CORS.
# Unset (or '*') means same-origin only — wildcards are never honored with
# credentials. Example:
# CORS_ORIGIN=https://app.exprsn.io,https://admin.exprsn.io
TRUST_PROXY=false

# ---- TLS -------------------------------------------------------------------
TLS_ENABLED=true
TLS_CERT_PATH=./certs/platform.crt
TLS_KEY_PATH=./certs/platform.key
# TLS_CA_PATH=

# ---- Single Postgres database (per-module schemas) -------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exprsn
DB_USER=exprsn
DB_PASSWORD=change_me
DB_SSL=false
# When DB_SSL=true the server certificate is VERIFIED by default.
# Set to false only as an explicit (unsafe) opt-out:
# DB_SSL_REJECT_UNAUTHORIZED=true
# Path to a custom CA bundle to trust for the Postgres connection:
# DB_SSL_CA=./certs/db-ca.pem
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_LOGGING=false

# ---- Shared Redis ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Service-to-service auth (@exprsn/shared serviceToken/serviceClient) ---
# Per-service tokens are derived as HMAC-SHA256(serviceId, SERVICE_TOKEN_SECRET),
# binding each service identity to its credential. REQUIRED, >= 32 chars,
# must not be a placeholder. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SERVICE_TOKEN_SECRET=
#
# Legacy shared static token — accepted ONLY while SERVICE_TOKEN_LEGACY_ALLOW=true
# during migration. Remove both once all services use SERVICE_TOKEN_SECRET.
# SERVICE_TOKEN_LEGACY_ALLOW=false
# SERVICE_TOKEN=
#
# Identity this process presents on outbound CA calls (X-Service-ID header).
# The unified platform runs as one process, so one identity covers all modules.
SERVICE_ID=platform

# ---- Internal module base URLs (now all the single origin + prefix) --------
# Modules are in-process; these remain only for code paths that still issue
# HTTP calls through the gateway.
CA_SERVICE_URL=https://localhost:8443/ca
# CA_URL / CA_BASE_URL are the names read by the shared token + socket
# validators and the spark/timeline module configs (default localhost:3000).
CA_URL=https://localhost:8443/ca
CA_BASE_URL=https://localhost:8443/ca
AUTH_SERVICE_URL=https://localhost:8443/auth
SPARK_SERVICE_URL=https://localhost:8443/spark
NEXUS_SERVICE_URL=https://localhost:8443/nexus
FILEVAULT_SERVICE_URL=https://localhost:8443/filevault
VAULT_SERVICE_URL=https://localhost:8443/vault
TIMELINE_SERVICE_URL=https://localhost:8443/timeline
PREFETCH_SERVICE_URL=https://localhost:8443/prefetch
MODERATOR_SERVICE_URL=https://localhost:8443/moderator
LIVE_SERVICE_URL=https://localhost:8443/live
# Timeline notifications: there is no standalone Herald service in the platform;
# timeline posts notifications to the moderator module, which bridges them onto
# its /notifications socket namespace. Set HERALD_ENABLED=false to disable.
HERALD_SERVICE_URL=https://localhost:8443/moderator

# ---- Auth / identity -------------------------------------------------------
JWT_SECRET=change_me
SESSION_SECRET=change_me
OIDC_ISSUER=https://localhost:8443/auth
# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Email (auth / moderator) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=

# ---- Moderator AI providers -----------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- FileVault storage -----------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# IPFS_API_URL=

# ---- Elasticsearch (spark / timeline / filevault) --------------------------
ELASTICSEARCH_NODE=http://localhost:9200

# ---- Live streaming (Cloudflare) ------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# ============================================================================
# Docker infrastructure stack (docker-compose.yml + `npm run infra:*`)
# Compose auto-loads this file; these values feed both the containers and the
# Node process. Ports are host-side and can be remapped to avoid conflicts.
# ============================================================================

# ---- RabbitMQ (extras broker) ---------------------------------------------
RABBITMQ_USER=exprsn
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---- nginx edge (front of the :8443 Node gateway) -------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- OpenLDAP (directory; ca module / ldapjs) -----------------------------
LDAP_ORG=Exprsn
LDAP_DOMAIN=exprsn.local
LDAP_ADMIN_PASSWORD=change_me
LDAP_PORT=389
LDAPS_PORT=636

# ---- BIND9 DNS ------------------------------------------------------------
DNS_PORT=53

# ---- Kerberos (KDC + kadmin) ----------------------------------------------
KRB5_REALM=EXPRSN.LOCAL
KRB5_KDC=kerberos
KRB5_ADMIN_PASSWORD=change_me
KRB_KDC_PORT=88
KRB_KADMIN_PORT=749

# ---- Dovecot (IMAP/POP3) --------------------------------------------------
IMAP_PORT=143
IMAPS_PORT=993
POP3_PORT=110
POP3S_PORT=995

# ---- strongSwan / Wireshark run on host networking (no port vars) ---------
TZ=UTC
