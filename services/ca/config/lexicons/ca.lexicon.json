    },
    {
      "id": "certificates.csr",
      "type": "procedure",
      "description": "Sign a certificate from a submitted CSR",
      "path": "/api/certificates/csr",
      "method": "POST",
      "auth": "admin",
      "rateLimit": { "window": 60000, "max": 10 }
    },
    {
      "id": "certificates.renew",
      "type": "procedure",
      "description": "Renew a certificate",
      "path": "/api/certificates/:id/renew",
      "method": "POST",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 10 }
    },
    {
      "id": "certificates.chain",
      "type": "query",
      "description": "Get a certificate's full chain",
      "path": "/api/certificates/:id/chain",
      "method": "GET",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 100 }
    },
    {
      "id": "certificates.download",
      "type": "query",
      "description": "Download a certificate (pem/der)",
      "path": "/api/certificates/:id/download",
      "method": "GET",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 100 }
    },
    {
      "id": "auth.verifyPassword",
      "type": "procedure",
      "description": "Verify a user's password",
      "path": "/api/auth/verify-password",
      "method": "POST",
      "auth": "required",
      "rateLimit": { "window": 60000, "max": 20 }
    },
    {
      "id": "config.getSection",
      "type": "query",
